# Preview service configuration (installed to /etc/preview/preview.env, mode 0600).
# This is an EXAMPLE. install-system.sh generates the real file with a random
# API key and fills PREVIEW_PUBLIC_HOST from your domain.

# --- API ---
PREVIEW_API_KEY=__REPLACE_WITH_RANDOM__
PREVIEW_BIND=127.0.0.1
PREVIEW_PORT=8787
PREVIEW_PUBLIC_HOST=preview.example.com
PREVIEW_PUBLIC_SCHEME=https

# Serve the published previews from this process too (no nginx). The system
# install keeps this 0 (nginx serves static); the user/docker installs set 1.
PREVIEW_SERVE_STATIC=0

# --- policy ---
PREVIEW_DEFAULT_DAYS=7
PREVIEW_MAX_DAYS=30
# Same-name update is always on: re-publishing under a name (topic) that is still
# live AND not past its expiry overwrites it in place (stable URL); an expired
# name gets a new URL. Per-call overrides: ?new=1 / X-New: 1 forces a new URL;
# ?ttl=<seconds> / X-TTL sets a sub-day expiry; ?dry_run=1 / GET /_api/check
# predicts the action without publishing. (No server toggle to disable these.)

# --- paths (defaults are fine for the system install) ---
PREVIEW_LIVE_ROOT=/var/www/preview/live
PREVIEW_STATE_DIR=/var/lib/preview
PREVIEW_STATIC_DIR=/var/www/preview/static

# --- Git archive: push each published preview to a Gitea/Git repo (append-only) ---
# Pluggable: leave disabled until the repo + access exist. While disabled,
# nothing is cloned/committed (clean disk).
#
# Remote-authoritative storage: the remote keeps every version; the local repo
# is a depth-1 blob-less partial clone (commits+trees only, ~KBs). Renewing an
# expired preview streams its entry back from the remote on demand.
PREVIEW_GIT_ENABLED=0
PREVIEW_GIT_BRANCH=main
PREVIEW_GIT_REPO_DIR=/var/lib/preview/archive-repo
#
# Push/upload tuning (defaults suit slow uplinks / tiny boxes):
#PREVIEW_GIT_PUSH_TIMEOUT=3600        # seconds; must cover one full publish upload
#PREVIEW_GIT_LOCK_TIMEOUT=60          # wait this long on the archive lock, then fail
#PREVIEW_GIT_RESTORE_TIMEOUT=1800     # streaming one entry back at renew time
#PREVIEW_GIT_PENDING_MAX_COMMITS=30   # cap unpushed backlog while remote is down
#PREVIEW_GIT_PUSH_RETRY_BACKOFF=21600 # reaper waits 6h after a failed push
#
# SSH transport (recommended; uses root's ssh key):
#PREVIEW_GIT_REMOTE=git@<your-gitea-host>:<owner>/<repo>.git
#PREVIEW_GIT_KEY=/root/.ssh/id_ed25519
#PREVIEW_SSH_DIR=/root/.ssh
#PREVIEW_GIT_SSH_PORT=22
#
# HTTPS+token alternative:
#PREVIEW_GIT_REMOTE=https://<your-gitea-host>/<owner>/<repo>.git
#PREVIEW_GIT_USER=<gitea-username>
#PREVIEW_GIT_TOKEN=
